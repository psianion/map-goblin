# Pack publishing credentials — `pack-builder deploy` / `pack-builder rollback`.
#
# Copy to .env and fill in. .env is gitignored and must stay that way: these are WRITE
# credentials for the bucket every client reads packs from. They live on the machine that
# publishes and nowhere else — never in a Docker image, never in a browser bundle.
#
# Nothing here is needed to run or develop the app. Without it the bundled pack is served
# from the app's own /packs and everything works.

# --- Cloudflare R2 (required to publish) ---
# Account ID: Cloudflare dashboard → R2 → the hex string in the S3 API endpoint.
R2_ACCOUNT_ID=
# R2 → Manage API Tokens → Create token with Object Read & Write on the pack bucket only.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=good-goblin-packs

# Public origin the bucket is served from — the custom domain bound to the bucket, NOT
# the r2.cloudflarestorage.com endpoint. This is what browsers hit, and what
# VITE_CDN_BASE_URL is set to at image build time.
CDN_BASE_URL=https://packs.example.com

# --- Cache purge (optional) ---
# Without these, deploy skips the purge and metadata updates lag by its 5-minute TTL.
# Zone ID: Cloudflare dashboard → the domain → Overview → Zone ID.
# Token needs the "Cache Purge" permission on that zone.
CF_ZONE_ID=
CF_API_TOKEN=
