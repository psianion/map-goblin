# Sibling checkouts of other branches (git worktree add .worktrees/<name>).
.worktrees/
*.tsbuildinfo
coverage

# Publishing credentials. `pack-builder deploy` reads R2 write keys from here — these
# grant write access to the bucket the whole product reads from. Never committed, never
# baked into an image. .env.example carries the variable names and no values.
.env
.env.*
!.env.example

# vault/forge — generated + licensed source images stay local, never in git.
# forge/dist holds set masters + manifests; published art lives in the bucket,
# only the bundled baseline under canvas/public/packs is committed.
forge/staging/
forge/dist/
forge/jobs/
forge/examples/
catalog.db
packs/*/source/
assets/test/
# Local design-critique snapshots (impeccable tooling)
.impeccable/

# Discord bot runtime state (sqlite), never committed.
bot/data/
