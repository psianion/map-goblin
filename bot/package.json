{
  "name": "@dnd/bot",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "sync": "tsx src/bot/sync-commands.ts",
    "smoke": "tsx smoke/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ smoke/ --max-warnings 0",
    "check": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.0",
    "discord.js": "^14.26.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.4",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.2",
    "vitest": "^4.0.18"
  }
}
